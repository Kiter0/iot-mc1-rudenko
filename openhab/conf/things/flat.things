Thing mqtt:topic:flat_power "Потужність" (mqtt:broker:mosquitto) [ availabilityTopic="flat/main/power/status", payloadAvailable="online", payloadNotAvailable="offline" ] {
    Channels:
        Type number : value [ stateTopic="flat/main/power/telemetry", transformationPattern="JSONPATH:$.value" ]
        Type string : status [ stateTopic="flat/main/power/status" ]
}

Thing mqtt:topic:flat_light_livingroom "Світло: вітальня" (mqtt:broker:mosquitto) [ availabilityTopic="flat/livingroom/light/status", payloadAvailable="online", payloadNotAvailable="offline" ] {
    Channels:
        Type switch : power [ stateTopic="flat/livingroom/light/state", transformationPattern="JSONPATH:$.state", commandTopic="flat/livingroom/light/set", formatBeforePub="{\"state\":\"%s\"}", qos=1 ]
        Type dimmer : brightness [ stateTopic="flat/livingroom/light/state", transformationPattern="JSONPATH:$.brightness", commandTopic="flat/livingroom/light/set", formatBeforePub="{\"brightness\":%s}", qos=1 ]
        Type string : status [ stateTopic="flat/livingroom/light/status" ]
}

Thing mqtt:topic:flat_light_bedroom "Світло: спальня" (mqtt:broker:mosquitto) [ availabilityTopic="flat/bedroom/light/status", payloadAvailable="online", payloadNotAvailable="offline" ] {
    Channels:
        Type switch : power [ stateTopic="flat/bedroom/light/state", transformationPattern="JSONPATH:$.state", commandTopic="flat/bedroom/light/set", formatBeforePub="{\"state\":\"%s\"}", qos=1 ]
        Type dimmer : brightness [ stateTopic="flat/bedroom/light/state", transformationPattern="JSONPATH:$.brightness", commandTopic="flat/bedroom/light/set", formatBeforePub="{\"brightness\":%s}", qos=1 ]
        Type string : status [ stateTopic="flat/bedroom/light/status" ]
}

Thing mqtt:topic:flat_heater "Обігрівач" (mqtt:broker:mosquitto) [ availabilityTopic="flat/hall/heater/status", payloadAvailable="online", payloadNotAvailable="offline" ] {
    Channels:
        Type switch : power [ stateTopic="flat/hall/heater/state", transformationPattern="JSONPATH:$.state", commandTopic="flat/hall/heater/set", formatBeforePub="{\"state\":\"%s\"}", qos=1 ]
        Type number : setpoint [ stateTopic="flat/hall/heater/state", transformationPattern="JSONPATH:$.setpoint", commandTopic="flat/hall/heater/set", formatBeforePub="{\"setpoint\":%s}", qos=1 ]
        Type switch : heating [ stateTopic="flat/hall/heater/state", transformationPattern="JSONPATH:$.heating", on="true", off="false" ]
        Type string : status [ stateTopic="flat/hall/heater/status" ]
}