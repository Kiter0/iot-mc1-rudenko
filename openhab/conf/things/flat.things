Thing mqtt:topic:flat_motion_livingroom (mqtt:broker:mosquitto) "Рух: вітальня" [ availabilityTopic="flat/livingroom/motion/status", payloadAvailable="online", payloadNotAvailable="offline" ] {
    Channels:
        Type switch : value [ stateTopic="flat/livingroom/motion/telemetry", transformationPattern="JSONPATH:$.value", on="1", off="0" ]
        Type string : status [ stateTopic="flat/livingroom/motion/status" ]
}

Thing mqtt:topic:flat_motion_bedroom (mqtt:broker:mosquitto) "Рух: спальня" [ availabilityTopic="flat/bedroom/motion/status", payloadAvailable="online", payloadNotAvailable="offline" ] {
    Channels:
        Type switch : value [ stateTopic="flat/bedroom/motion/telemetry", transformationPattern="JSONPATH:$.value", on="1", off="0" ]
        Type string : status [ stateTopic="flat/bedroom/motion/status" ]
}

