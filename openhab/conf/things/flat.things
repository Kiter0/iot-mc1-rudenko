Thing mqtt:topic:flat_motion_livingroom "Рух: вітальня" (mqtt:broker:mosquitto) [ availabilityTopic="flat/livingroom/motion/status", payloadAvailable="online", payloadNotAvailable="offline" ] {
    Channels:
        Type switch : value [ stateTopic="flat/livingroom/motion/telemetry", transformationPattern="JSONPATH:$.value", on="1", off="0" ]
        Type string : status [ stateTopic="flat/livingroom/motion/status" ]
}

Thing mqtt:topic:flat_motion_bedroom "Рух: спальня" (mqtt:broker:mosquitto) [ availabilityTopic="flat/bedroom/motion/status", payloadAvailable="online", payloadNotAvailable="offline" ] {
    Channels:
        Type switch : value [ stateTopic="flat/bedroom/motion/telemetry", transformationPattern="JSONPATH:$.value", on="1", off="0" ]
        Type string : status [ stateTopic="flat/bedroom/motion/status" ]
}

