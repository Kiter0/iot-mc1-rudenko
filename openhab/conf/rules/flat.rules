// ===== Налаштування =====
// DEMO = true -> усі інтервали по 30 с (для відео та захисту)
val boolean DEMO = false
val int NO_MOTION_SEC  = if (DEMO) 30 else 300    // 5 хв без руху
val int EMPTY_HOME_SEC = if (DEMO) 30 else 1800   // 30 хв нікого вдома
val int OVERLOAD_SEC   = if (DEMO) 30 else 60     // 1 хв перевантаження
val int OVERLOAD_W     = 2500
val int LUX_LIMIT      = 50
val int LIGHT_LEVEL    = 70
val int ECO_SETPOINT   = 17
val int COMFORT_SETPOINT = 21

var Timer tOffLiving = null
var Timer tOffBedroom = null
var Timer tEmpty = null
var Timer tOverload = null

// ===== Правило 1a: рух + освітленість < 50 лк -> світло 70 % =====
rule "R1a: рух і темно -> світло 70%"
when
    Item Motion_Livingroom changed to ON or
    Item Motion_Bedroom changed to ON or
    Item Lux_Hall changed
then
    if (Lux_Hall.state instanceof Number && (Lux_Hall.state as Number).doubleValue < LUX_LIMIT) {
        if (Motion_Livingroom.state == ON && Light_Livingroom_Switch.state != ON) {
            Light_Livingroom_Switch.sendCommand(ON)
            Light_Livingroom_Dim.sendCommand(LIGHT_LEVEL)
            logInfo("flat", "R1a: вітальня, світло {}%", LIGHT_LEVEL)
        }
        if (Motion_Bedroom.state == ON && Light_Bedroom_Switch.state != ON) {
            Light_Bedroom_Switch.sendCommand(ON)
            Light_Bedroom_Dim.sendCommand(LIGHT_LEVEL)
            logInfo("flat", "R1a: спальня, світло {}%", LIGHT_LEVEL)
        }
    }
end

// ===== Правило 1b: без руху 5 хв -> вимкнути світло =====
rule "R1b: вітальня без руху -> вимкнути"
when
    Item Motion_Livingroom changed
then
    if (tOffLiving !== null) { tOffLiving.cancel(); tOffLiving = null }
    if (Motion_Livingroom.state != ON) {
        tOffLiving = createTimer(now.plusSeconds(NO_MOTION_SEC), [ |
            Light_Livingroom_Switch.sendCommand(OFF)
            logInfo("flat", "R1b: вітальня без руху, світло вимкнено")
            tOffLiving = null
        ])
    }
end

rule "R1b: спальня без руху -> вимкнути"
when
    Item Motion_Bedroom changed
then
    if (tOffBedroom !== null) { tOffBedroom.cancel(); tOffBedroom = null }
    if (Motion_Bedroom.state != ON) {
        tOffBedroom = createTimer(now.plusSeconds(NO_MOTION_SEC), [ |
            Light_Bedroom_Switch.sendCommand(OFF)
            logInfo("flat", "R1b: спальня без руху, світло вимкнено")
            tOffBedroom = null
        ])
    }
end

// ===== Правило 2: нікого вдома 30 хв -> «Економ» 17 °C; рух -> 21 °C =====
rule "R2: режим Економ"
when
    Item Motion_Livingroom changed or
    Item Motion_Bedroom changed or
    System started
then
    val anyone = (Motion_Livingroom.state == ON) || (Motion_Bedroom.state == ON)
    if (anyone) {
        if (tEmpty !== null) { tEmpty.cancel(); tEmpty = null }
        if (Eco_Mode.state == ON) {
            Eco_Mode.sendCommand(OFF)
            Heater_Setpoint.sendCommand(COMFORT_SETPOINT)
            logInfo("flat", "R2: з'явився рух, уставка {} °C", COMFORT_SETPOINT)
        }
    } else if (tEmpty === null) {
        tEmpty = createTimer(now.plusSeconds(EMPTY_HOME_SEC), [ |
            Eco_Mode.sendCommand(ON)
            Heater_Setpoint.sendCommand(ECO_SETPOINT)
            logInfo("flat", "R2: нікого вдома, Економ, уставка {} °C", ECO_SETPOINT)
            tEmpty = null
        ])
    }
end

// ===== Правило 3: потужність > 2500 Вт понад 1 хв -> сповіщення + вимкнути обігрівач =====
rule "R3: перевантаження мережі"
when
    Item Power_Flat changed
then
    val p = if (Power_Flat.state instanceof Number) (Power_Flat.state as Number).doubleValue else 0.0
    if (p > OVERLOAD_W) {
        if (tOverload === null) {
            tOverload = createTimer(now.plusSeconds(OVERLOAD_SEC), [ |
                tOverload = null
                if (Power_Flat.state instanceof Number && (Power_Flat.state as Number).doubleValue > OVERLOAD_W) {
                    Alarm_Overload.sendCommand(ON)
                    Alert_Text.postUpdate("Перевантаження! Обігрівач вимкнено о " + now.toString().substring(11, 19))
                    Heater_Switch.sendCommand(OFF)
                    logWarn("flat", "R3: перевантаження > {} Вт, обігрівач вимкнено", OVERLOAD_W)
                }
            ])
        }
    } else if (tOverload !== null) {
        tOverload.cancel()
        tOverload = null
    }
end

rule "R3b: скидання тривоги"
when
    Item Alarm_Overload changed to OFF
then
    Alert_Text.postUpdate("Все гаразд")
end